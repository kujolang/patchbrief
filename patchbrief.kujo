# PatchBrief — inspect git diffs and generate structured implementation briefs.
#
# Usage:
#   kujo run patchbrief.kujo -- summarize [--format markdown|json] [--pretty]
#   kujo run patchbrief.kujo -- suggest-tests
#   kujo run patchbrief.kujo -- handoff [--format markdown|json] [--pretty]
#   kujo run patchbrief.kujo -- version
#   kujo run patchbrief.kujo -- help

from src.common import parse_subcommand, flag_value, has_flag, str_starts_with
from src.git import is_git_repo

VERSION := "0.1.0"

func print_help() {
	print("PatchBrief v" + VERSION)
	print("")
	print("A local developer tool that inspects git diffs and generates")
	print("structured implementation briefs.")
	print("")
	print("Usage:")
	print("  kujo run patchbrief.kujo -- summarize [--format markdown|json] [--pretty]")
	print("  kujo run patchbrief.kujo -- suggest-tests")
	print("  kujo run patchbrief.kujo -- handoff [--format markdown|json] [--pretty]")
	print("  kujo run patchbrief.kujo -- version")
	print("  kujo run patchbrief.kujo -- help")
	print("")
	print("Commands:")
	print("  summarize     Generate a summary of the current git diff")
	print("  suggest-tests Suggest test commands based on changed files")
	print("  handoff       Generate a structured handoff note for reviewers")
	print("  version       Print version information")
	print("  help          Print this help message")
	print("")
	print("Options:")
	print("  --format      Output format: markdown (default) or json")
	print("  --pretty      Pretty-print JSON output when --format json is used")
	print("")
	print("Examples:")
	print("  kujo run patchbrief.kujo -- summarize")
	print("  kujo run patchbrief.kujo -- summarize --format json --pretty")
	print("  kujo run patchbrief.kujo -- suggest-tests")
	print("  kujo run patchbrief.kujo -- handoff")
	print("")
	print("Note: Use '--' before script arguments to avoid Kujo CLI flag parsing conflicts.")
}

func print_version() {
	print("PatchBrief v" + VERSION)
	print("A Kujo/Kujo ecosystem dogfood showcase tool.")
	print("https://github.com/kujolang/patchbrief")
}

func main() {
	argv := args()
	if len(argv) < 1 {
		print_help()
		exit(0)
	}
	subcommand := parse_subcommand(argv)
	if subcommand == "" || subcommand == "help" {
		if len(argv) > 0 {
			first := to_string(argv[0])
			if str_starts_with(first, "--") {
				print("Error: Command must come before PatchBrief flags.")
				print("Example: kujo run patchbrief.kujo -- summarize --format json")
				print("")
			}
		}
		print_help()
		exit(0)
	}
	if subcommand == "version" {
		print_version()
		exit(0)
	}
	# Pre-flight check for commands that need a git repo
	if subcommand == "summarize" || subcommand == "suggest-tests" || subcommand == "handoff" {
		if is_git_repo() == false {
			print("Error: Not a git repository.")
			print("PatchBrief requires a git repository to inspect diffs.")
			print("Run 'git init' to initialize a repository, or run 'patchbrief help' for usage.")
			exit(1)
		}
	}
	if subcommand == "summarize" {
		format := flag_value(argv, "--format", "markdown")
		pretty_json := has_flag(argv, "--pretty")
		lower_format := to_lower(format)
		if lower_format != "markdown" && lower_format != "json" {
			print("Error: Invalid format '" + format + "'.")
			print("Valid formats are: markdown, json")
			exit(2)
		}
		if lower_format == "json" {
			from src.summarize import summarize_json
			summarize_json(pretty_json)
		} else {
			from src.summarize import summarize_markdown
			summarize_markdown()
		}
		exit(0)
	}
	if subcommand == "suggest-tests" {
		from src.suggest_tests import suggest_tests
		suggest_tests()
		exit(0)
	}
	if subcommand == "handoff" {
		format := flag_value(argv, "--format", "markdown")
		pretty_json := has_flag(argv, "--pretty")
		lower_format := to_lower(format)
		if lower_format != "markdown" && lower_format != "json" {
			print("Error: Invalid format '" + format + "'.")
			print("Valid formats are: markdown, json")
			exit(2)
		}
		if lower_format == "json" {
			from src.handoff import handoff_json
			handoff_json(pretty_json)
		} else {
			from src.handoff import handoff_markdown
			handoff_markdown()
		}
		exit(0)
	}
	# Unknown subcommand
	print("Error: Unknown command '" + subcommand + "'")
	print("Run 'kujo run patchbrief.kujo -- help' for usage.")
	exit(2)
}

main()
