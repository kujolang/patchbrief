# PatchBrief test suite.
# Validates CLI behavior, output formats, and error handling.
#
# Run with: kujo test

func text_contains(text, needle) {
	from src.common import str_contains
	return str_contains(text, needle)
}

func list_contains_text(items, needle) {
	idx := 0
	while idx < len(items) {
		if text_contains(to_string(items[idx]), needle) {
			return true
		}
		idx := idx + 1
	}
	return false
}

func json_files_include(parsed, expected_path) {
	files := parsed["files"]
	idx := 0
	while idx < len(files) {
		if files[idx]["path"] == expected_path {
			return true
		}
		idx := idx + 1
	}
	return false
}

KUJO_BIN := env_or("KUJO_BIN", "kujo")
PATCHBRIEF_ENTRYPOINT := path_absolute("patchbrief.kujo")

func patchbrief_command(arguments) {
	from src.common import shell_quote
	return shell_quote(KUJO_BIN) + " run " + shell_quote(PATCHBRIEF_ENTRYPOINT) + " -- " + arguments
}

# Test 1: help command prints usage and exits 0
func test_help_prints_usage() {
	result := execute(patchbrief_command("help") + " 2>&1", {"timeout_ms": 15000})
	output := to_string(result)
	assert(text_contains(output, "Usage"), "help should print usage information")
	assert(text_contains(output, "summarize"), "help should mention summarize command")
	assert(text_contains(output, "suggest-tests"), "help should mention suggest-tests command")
	assert(text_contains(output, "handoff"), "help should mention handoff command")
}

# Test 1b: help command output stays copy/paste stable
func test_help_exact_output() {
	from src.common import str_join
	result := execute(patchbrief_command("help") + " 2>&1", {"timeout_ms": 15000})
	output := to_string(result)
	expected := str_join([
		"PatchBrief v1.0.0",
		"",
		"A local developer tool that inspects git diffs and generates",
		"structured implementation briefs.",
		"",
		"Usage:",
		"  kujo run patchbrief.kujo -- summarize [--format markdown|json] [--pretty]",
		"  kujo run patchbrief.kujo -- suggest-tests",
		"  kujo run patchbrief.kujo -- handoff [--format markdown|json] [--pretty]",
		"  kujo run patchbrief.kujo -- version",
		"  kujo run patchbrief.kujo -- help",
		"",
		"Commands:",
		"  summarize     Generate a summary of the current git diff",
		"  suggest-tests Suggest test commands based on changed files",
		"  handoff       Generate a structured handoff note for reviewers",
		"  version       Print version information",
		"  help          Print this help message",
		"",
		"Options:",
		"  --format      Output format: markdown (default) or json",
		"  --pretty      Pretty-print JSON output when --format json is used",
		"",
		"Examples:",
		"  kujo run patchbrief.kujo -- summarize",
		"  kujo run patchbrief.kujo -- summarize --format json --pretty",
		"  kujo run patchbrief.kujo -- suggest-tests",
		"  kujo run patchbrief.kujo -- handoff",
		"",
		"Note: Use '--' before script arguments to avoid Kujo CLI flag parsing conflicts."
	], "\n") + "\n"
	assert(output == expected, "help output should match the canonical text exactly")
}

# Test 2: version command prints version
func test_version_prints_version() {
	result := execute(patchbrief_command("version") + " 2>&1", {"timeout_ms": 15000})
	output := to_string(result)
	assert(text_contains(output, "PatchBrief"), "version should print tool name")
	assert(text_contains(output, "1.0.0"), "version should print version number")
}

# Test 3: no subcommand prints help
func test_no_subcommand_prints_help() {
	result := execute(patchbrief_command("") + " 2>&1", {"timeout_ms": 15000})
	output := to_string(result)
	assert(text_contains(output, "Usage"), "no subcommand should print usage")
}

# Test 4: unknown subcommand exits with error
func test_unknown_subcommand_errors() {
	result := execute_status(patchbrief_command("nonexistent-command"), {"timeout_ms": 15000})
	assert(result.exitcode == 2, "unknown command should exit 2")
	output := to_string(result.stdout) + to_string(result.stderr)
	assert(text_contains(output, "Unknown command 'nonexistent-command'"), "unknown command should name the invalid command")
}

# Test 5: git module detects repo correctly
func test_git_is_repo_detection() {
	from src.git import is_git_repo
	# This test runs inside a git repo (the patchbrief project itself)
	assert(is_git_repo() == true, "should detect current directory as a git repo")
}

# Test 6: git module returns branch name
func test_git_current_branch() {
	from src.git import current_branch
	branch := current_branch()
	assert(branch != "", "branch should not be empty")
	assert(branch != "unknown", "branch should be a real branch name")
}

# Test 7: git module returns repo name
func test_git_repo_name() {
	from src.git import repo_name
	name := repo_name()
	assert(name != "", "repo name should not be empty")
	assert(name != "unknown", "repo name should be a real name")
}

# Test 8: common module parse_subcommand works
func test_parse_subcommand() {
	from src.common import parse_subcommand
	# args() returns only user args, not the script name
	result1 := parse_subcommand(["summarize"])
	assert(result1 == "summarize", "should parse summarize subcommand")
	result2 := parse_subcommand(["handoff", "--format", "json"])
	assert(result2 == "handoff", "should parse handoff subcommand")
	result3 := parse_subcommand(["--format", "json"])
	assert(result3 == "", "leading flags without command should return empty")
}

# Test 9: common module has_flag works
func test_has_flag() {
	from src.common import has_flag
	assert(has_flag(["--format", "json"], "--format") == true, "should detect --format flag")
	assert(has_flag(["summarize"], "--format") == false, "should not detect missing flag")
}

# Test 10: common module flag_value works
func test_flag_value() {
	from src.common import flag_value
	val := flag_value(["--format", "json"], "--format", "markdown")
	assert(val == "json", "should return flag value")
	default_val := flag_value(["summarize"], "--format", "markdown")
	assert(default_val == "markdown", "should return default when flag missing")
}

# Test 11: summarize generates markdown output
func test_summarize_markdown() {
	result := execute(patchbrief_command("summarize") + " 2>&1", {"timeout_ms": 30000})
	output := to_string(result)
	assert(text_contains(output, "PatchBrief Summary"), "summarize should produce markdown heading")
}

# Test 12: summarize --format json generates valid JSON structure
func test_summarize_json() {
	result := execute(patchbrief_command("summarize --format json") + " 2>&1", {"timeout_ms": 30000})
	output := to_string(result)
	assert(text_contains(output, "\"repo\":"), "json output should contain repo field")
	assert(text_contains(output, "\"branch\":"), "json output should contain branch field")
	assert(text_contains(output, "\"summary\":"), "json output should contain summary field")
	assert(text_contains(output, "\"risk_areas\":"), "json output should contain risk_areas field")
	assert(text_contains(output, "PatchBrief Summary") == false, "json mode should not output markdown header")
	parsed := parse_json(output)
	assert(type(parsed) != "Error", "summarize --format json should produce valid JSON")
}

# Test 12b: summarize --format json --pretty produces pretty-printed JSON
func test_summarize_json_pretty() {
	result := execute(patchbrief_command("summarize --format json --pretty") + " 2>&1", {"timeout_ms": 30000})
	output := to_string(result)
	assert(text_contains(output, "\n  \"repo\""), "pretty json should contain indentation")
	parsed := parse_json(output)
	assert(type(parsed) != "Error", "pretty summarize json should be valid JSON")
}

# Test 12c: staged and untracked files are included in summaries
func test_summarize_json_includes_staged_and_untracked_files() {
	from src.common import shell_quote
	script_path := path_absolute("patchbrief.kujo")
	cmd := "tmp=$(mktemp -d); cd \"$tmp\" && git init -q && git config user.email test@example.com && git config user.name Test && printf 'base\\n' > tracked.kujo && git add tracked.kujo && git commit -m init -q && printf 'change\\n' >> tracked.kujo && git add tracked.kujo && printf 'notes\\n' > notes.md && " + shell_quote(KUJO_BIN) + " run " + shell_quote(script_path) + " -- summarize --format json 2>&1"
	result := execute(cmd, {"timeout_ms": 30000})
	output := to_string(result)
	parsed := parse_json(output)
	assert(type(parsed) != "Error", "summary with staged and untracked files should be valid JSON")
	assert(parsed["summary"]["files_changed"] == 2, "summary should count staged and untracked files")
	assert(text_contains(output, "\"path\":\"tracked.kujo\""), "summary should include staged tracked file")
	assert(text_contains(output, "\"path\":\"notes.md\""), "summary should include untracked file")
}

# Test 12d: risk messages are deduplicated across matching files
func test_identify_risks_deduplicates_repeated_categories() {
	from src.summarize import identify_risks
	risks := identify_risks(["tests/unit_test.kujo", "tests/integration_spec.kujo"], "")
	assert(len(risks) == 1, "repeated risk categories should only be reported once")
	assert(text_contains(to_string(risks[0]), "Test changes"), "deduplicated risk should preserve the category text")
}

