	output := to_string(result)
	assert(text_contains(output, "Test Suggestions"), "suggest-tests should produce heading")
}

# Test 14: handoff generates handoff note
func test_handoff_markdown() {
	result := execute(patchbrief_command("handoff") + " 2>&1", {"timeout_ms": 30000})
	output := to_string(result)
	assert(text_contains(output, "Handoff Note"), "handoff should produce heading")
