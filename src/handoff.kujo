# Handoff module — generates structured handoff notes for reviewers or downstream agents.

from src.git import is_git_repo, current_branch, repo_name, diff_stat, changed_files, full_diff, recent_commits
from src.common import timestamp_now
from src.summarize import infer_purpose, identify_risks

# Generate a Markdown handoff note.
export func handoff_markdown() {
	if is_git_repo() == false {
		print("Error: Not a git repository. Run patchbrief inside a git repo.")
		exit(1)
	}
	branch := current_branch()
	repo := repo_name()
	stat := diff_stat()
	files := changed_files()
	diff_text := full_diff()
	purpose := infer_purpose(files, diff_text)
	risks := identify_risks(files, diff_text)
	commits := recent_commits(5)
	ts := timestamp_now()
	print("# Handoff Note: " + repo + " — " + branch)
	print("")
	print("**Date:** " + ts)
	print("**Branch:** " + branch)
	print("**Changed Files:** " + to_string(stat["files"]) + " (+" + to_string(stat["added"]) + "/-" + to_string(stat["removed"]) + ")")
	print("")
	print("## Summary")
	print("")
	print(purpose)
	print("")
	print("## What Changed")
	print("")
	fi_idx := 0
	while fi_idx < len(files) {
		f := to_string(files[fi_idx])
		print("- `" + f + "`")
		fi_idx := fi_idx + 1
	}
	print("")
	print("## Risk Assessment")
	print("")
	ri := 0
	while ri < len(risks) {
		print("- " + to_string(risks[ri]))
		ri := ri + 1
	}
	print("")
	print("## Recent Commits")
	print("")
	if len(commits) > 0 {
		ci := 0
		while ci < len(commits) {
			print("- " + to_string(commits[ci]))
			ci := ci + 1
		}
	} else {
		print("No recent commits found.")
	}
	print("")
	print("## Reviewer Notes")
	print("")
	print("- [ ] Changes look correct")
	print("- [ ] Tests pass")
	print("- [ ] No security concerns")
	print("- [ ] Documentation updated if needed")
	print("")
	print("## For the Next Agent/Developer")
	print("")
	print("```")
	print("kujo run patchbrief.kujo -- summarize")
	print("kujo run patchbrief.kujo -- suggest-tests")
	print("```")
	print("")
	print("---")
	print("*Handoff generated by PatchBrief v0.1.0 at " + ts + "*")
}

# Generate a JSON handoff note.
export func handoff_json(pretty_json) {
	if is_git_repo() == false {
		error_obj := {
			"error": true,
			"message": "Not a git repository. Run patchbrief inside a git repo."
		}
		print(to_json(error_obj))
		exit(1)
	}
	branch := current_branch()
	repo := repo_name()
	stat := diff_stat()
	files := changed_files()
	diff_text := full_diff()
	purpose := infer_purpose(files, diff_text)
	risks := identify_risks(files, diff_text)
	commits := recent_commits(5)
	ts := timestamp_now()
	# Build file array
	file_list := []
	fi := 0
	while fi < len(files) {
		file_list := push(file_list, to_string(files[fi]))
		fi := fi + 1
	}
	output := {
		"format": "patchbrief-handoff",
		"version": "0.1.0",
		"generated_at": ts,
		"repo": repo,
		"branch": branch,
		"summary": {
			"files_changed": stat["files"],
			"lines_added": stat["added"],
			"lines_removed": stat["removed"],
			"likely_purpose": purpose
		},
		"files": file_list,
		"risk_areas": risks,
		"recent_commits": commits,
		"reviewer_checklist": [
			"Changes look correct",
			"Tests pass",
			"No security concerns",
			"Documentation updated if needed"
		]
	}
	if pretty_json == true {
		print(to_json_pretty(output))
		return
	}
	print(to_json(output))
}
