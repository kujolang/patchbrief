# Suggest tests module — analyzes changed files and suggests test commands.

from src.git import is_git_repo, changed_files
from src.common import str_contains, str_lower, str_ends_with, dict_has_key

# File pattern to test suggestion mapping.
TEST_SUGGESTIONS := {
	".kujo": ["kujo test"],
	".rs": ["cargo test", "cargo clippy --all-targets --all-features -- -D warnings"],
	".py": ["python -m pytest", "python -m unittest discover"],
	".js": ["npm test", "npx jest"],
	".ts": ["npm test", "npx jest", "npx tsc --noEmit"],
	".jsx": ["npm test", "npx jest"],
	".tsx": ["npm test", "npx jest", "npx tsc --noEmit"],
	".php": ["php vendor/bin/phpunit", "php artisan test"],
	".rb": ["bundle exec rspec", "bundle exec rake test"],
	".go": ["go test ./...", "go vet ./..."],
	".java": ["./gradlew test", "mvn test"],
	".kt": ["./gradlew test"],
	".swift": ["swift test", "xcodebuild test"],
	".sh": ["shellcheck *.sh", "bash -n script.sh"],
	".md": ["markdownlint *.md"],
	".css": ["npx stylelint '**/*.css'"],
	".json": ["npx jsonlint --quiet *.json"],
	".yaml": ["yamllint ."],
	".yml": ["yamllint ."],
	".sql": ["# Review migration safety manually"],
	".dockerfile": ["docker build --check .", "hadolint Dockerfile"],
	".tf": ["terraform validate", "terraform fmt -check"]
}

# Get unique test suggestions for a set of files.
func suggestions_for_files(files_list) {
	suggestions_set := {}
	result := []
	fi := 0
	while fi < len(files_list) {
		f := str_lower(to_string(files_list[fi]))
		is_dockerfile := f == "dockerfile" || str_ends_with(f, "/dockerfile")
		extensions := [".kujo", ".rs", ".py", ".js", ".ts", ".jsx", ".tsx", ".php", ".rb", ".go", ".java", ".kt", ".swift", ".sh", ".md", ".css", ".json", ".yaml", ".yml", ".sql", ".dockerfile", ".tf"]
		ei := 0
		while ei < len(extensions) {
			ext := to_string(extensions[ei])
			is_match := false
			if ext == ".dockerfile" {
				is_match := is_dockerfile
			} else {
				is_match := str_ends_with(f, ext)
			}
			if is_match {
				cmds := TEST_SUGGESTIONS[ext]
				ci := 0
				while ci < len(cmds) {
					cmd := to_string(cmds[ci])
					# Check if already added
					if dict_has_key(suggestions_set, cmd) == false {
						suggestions_set[cmd] := true
						result := push(result, cmd)
					}
					ci := ci + 1
				}
			}
			ei := ei + 1
		}
		fi := fi + 1
	}
	if len(result) == 0 {
		result := push(result, "# No specific test commands found — review changes manually")
	}
	return result
}

# Generate test suggestions.
export func suggest_tests() {
	if is_git_repo() == false {
		print("Error: Not a git repository. Run patchbrief inside a git repo.")
		exit(1)
	}
	files := changed_files()
	if len(files) == 0 {
		print("# PatchBrief Test Suggestions")
		print("")
		print("No uncommitted changes detected. Nothing to test.")
		return
	}
	print("# PatchBrief Test Suggestions")
	print("")
	print("Based on the changed files, consider running:")
	print("")
	suggestions := suggestions_for_files(files)
	si := 0
	while si < len(suggestions) {
		print("- `" + to_string(suggestions[si]) + "`")
		si := si + 1
	}
	print("")
	print("## General Validation")
	print("")
	print("- Review all changed files for correctness")
	print("- Check for leftover debug logging or commented-out code")
	print("- Verify any new configuration values are documented")
	print("")
	print("## Manual Checks")
	print("")
	# Per-file suggestions
	fi_idx := 0
	while fi_idx < len(files) {
		f := str_lower(to_string(files[fi_idx]))
		if str_contains(f, "readme") || str_contains(f, ".md") {
			print("- Preview Markdown rendering for `" + to_string(files[fi_idx]) + "`")
		}
		if str_contains(f, "config") || str_contains(f, ".env") {
			print("- Verify environment-specific values in `" + to_string(files[fi_idx]) + "`")
		}
		if str_contains(f, "migration") || str_contains(f, "schema") {
			print("- Test migration rollback for `" + to_string(files[fi_idx]) + "`")
		}
		fi_idx := fi_idx + 1
	}
	print("")
	print("---")
	print("*Generated by PatchBrief v0.1.0*")
}
